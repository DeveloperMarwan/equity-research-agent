# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored. Never commit real keys.

# Required. OpenAI API key (https://platform.openai.com/api-keys).
# Used by all five agents via the OpenAI Agents SDK.
OPENAI_API_KEY=your-openai-api-key-here

# Required. Tavily search API key (https://app.tavily.com).
# Used by the Financial Data, Comparable Companies and Risk agents.
TAVILY_API_KEY=your-tavily-api-key-here

# Recommended. Contact identity sent to the SEC with EDGAR requests
# (https://www.sec.gov/os/webmaster-faq#developers), in the form "Your Name your@email.com".
# If unset, the Risk Analysis Agent skips SEC filings and falls back to web search.
EDGAR_IDENTITY=Your Name your-email@example.com
